# Database Configuration
DB_PATH=hr_management.db          # SQLite file location (relative to project root)

# Application Security
SECRET_KEY=change-me-to-a-long-random-secret

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
EMAIL_SENDER=your_email@gmail.com
EMAIL_PASSWORD=your_gmail_app_password  # Use a Gmail App Password, NOT your account password
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

# OTP settings
OTP_EXPIRY_MINUTES=10

# ── Gmail API (for HR Email Dashboard) ───────────────────────────────────────
# Download credentials.json from Google Cloud Console → APIs & Services → Credentials
# Place credentials.json in the project root directory (it is gitignored)

# ── Gemini AI (for email classification) ─────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
